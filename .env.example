# Constellation environment configuration. Copy to `.env` and fill as needed.
# The scaffold runs fully locally with NO credentials (fixture-backed mocks).
# These are only needed to wire real integrations.

# --- Logging / observability ---
LOG_LEVEL=info          # trace|debug|info|warn|error|silent
LOG_PRETTY=0            # 1 for pretty (pino-pretty) output
LOG_TO_STDERR=0         # 1 to route logs to stderr (auto-on for the RPC transport)

# --- Graph persistence (CLI) ---
CONSTELLATION_GRAPH=./.constellation/graph.json

# --- Connector mode ---
CONSTELLATION_CONNECTOR_MODE=mock   # mock | composio

# --- mcporter bridge (optional, lazy; vendor-neutral display/back-compat) ---
MCPORTER_ENDPOINT=
MCPORTER_SERVERS=composio

# --- Composio (optional, lazy; talks through mcporter) ---
# AUTH is a single consumer key sent as the `x-consumer-api-key` header (NOT a
# bearer token). Set CONSTELLATION_CONNECTOR_MODE=composio to activate. With a
# key present, email/slack/calendar use real Composio reads; doc and
# meeting_transcript always stay on mocks.
COMPOSIO_API_KEY=ck__your_consumer_key_here
COMPOSIO_ENDPOINT=https://connect.composio.dev/mcp   # hosted MCP meta-router url
COMPOSIO_PROJECT_ID=                                 # optional; sent as x-project-id only if set
COMPOSIO_ENTITY_ID=                                  # optional; unused by the meta-router
# Account-specific read targets:
COMPOSIO_CALENDAR_ID=primary                         # Google Calendar id ("primary" = the authed user's)
COMPOSIO_SLACK_CHANNEL=                              # Slack channel/conversation id; blank => Slack reads skipped

# --- Pi model-driven path (optional; `constellation model "<task>"`) ---
# The model-driven path talks to a custom Anthropic-compatible gateway. The base
# URL and key are carried on the Model object (registered programmatically), NOT
# read by the SDK from env — so these specific names are what Constellation reads.
ANTHROPIC_BASE_URL=https://your-gateway.example/anthropic   # custom gateway URL (Anthropic-compatible)
ANTHROPIC_API_KEY=                                          # your gateway API key (x-api-key auth)
CONSTELLATION_MODEL=glm-5.1                                 # wire model id sent to the gateway

# --- Slack interface via @mariozechner/pi-mom (optional) ---
MOM_SLACK_APP_TOKEN=
MOM_SLACK_BOT_TOKEN=
