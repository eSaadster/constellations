# Constellation environment configuration. Copy to `.env` and fill as needed.
# The scaffold runs fully locally with NO credentials (fixture-backed mocks).
# These are only needed to wire real integrations.

# --- Logging / observability ---
LOG_LEVEL=info          # trace|debug|info|warn|error|silent
LOG_PRETTY=0            # 1 for pretty (pino-pretty) output
LOG_TO_STDERR=0         # 1 to route logs to stderr (auto-on for the RPC transport)

# --- Graph persistence (CLI) ---
CONSTELLATION_GRAPH=./.constellation/graph.json

# --- Connector mode ---
CONSTELLATION_CONNECTOR_MODE=mock   # mock | composio

# --- mcporter bridge (optional, lazy) ---
MCPORTER_ENDPOINT=
MCPORTER_SERVERS=composio
MCPORTER_TOKEN=

# --- Composio (optional, lazy; talks through mcporter) ---
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=

# --- Pi model-driven path (optional) ---
ANTHROPIC_API_KEY=

# --- Slack interface via @mariozechner/pi-mom (optional) ---
MOM_SLACK_APP_TOKEN=
MOM_SLACK_BOT_TOKEN=
